# DataPilot AI — Environment Configuration
# Copy this file to .env and fill in values as needed.
# Every variable has a safe default (see app/core/config.py), so the app
# runs out of the box with LLM_PROVIDER=mock and no keys at all.
#
# For cloud-native mode, set the AWS and LLM variables below.
# Never commit .env to version control.

# ===========================================================================
# LLM Configuration
# ===========================================================================

# Legacy single-provider mode (still works; used as fallback for primary/fallback)
# "mock" (default, no key needed, deterministic) | "gemini" | "groq" | "anthropic" | "ollama"
LLM_PROVIDER=mock

# Cloud-native primary/fallback chain
# PRIMARY_LLM_PROVIDER=gemini
# FALLBACK_LLM_PROVIDER=groq

# Gemini (primary LLM provider — recommended)
# GEMINI_API_KEY=your_gemini_api_key_here
# GEMINI_MODEL=gemini-2.0-flash

# Groq (fallback LLM provider — ultra-fast Llama 3)
# GROQ_API_KEY=your_groq_api_key_here

# Anthropic (alternative provider)
# ANTHROPIC_API_KEY=your_anthropic_key_here

# Ollama (local models)
# OLLAMA_BASE_URL=http://localhost:11434

# Model name (used when LLM_PROVIDER is set to a non-Gemini provider)
LLM_MODEL=llama-3.3-70b-versatile

# ===========================================================================
# Local Development Mode
# ===========================================================================

# LOCAL_MODE=true: use local filesystem instead of S3, SQLite instead of RDS,
# direct pipeline calls instead of Lambda triggers.
# Set to false only when deploying to AWS.
LOCAL_MODE=true

# Root directory for local S3 simulation (LOCAL_MODE only)
LOCAL_STORAGE_ROOT=data/local_s3

# ===========================================================================
# ===========================================================================
# AWS Configuration (only required when LOCAL_MODE=false)
# ===========================================================================

# AWS_REGION=us-east-1
# AWS_S3_BUCKET=veridex-datasets-your-account-id
# AWS_PROFILE=default
# AWS_S3_ENDPOINT_URL=http://localhost:4566  # Optional: For LocalStack / MinIO testing

# Explicit credentials — leave blank when running inside AWS with IAM roles.
# Never commit actual key values.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# ===========================================================================
# Database Configuration
# ===========================================================================

# Application metadata database (projects, datasets, analyses, reports)
# Local dev: sqlite:///data/veridex_meta.db (default — no setup needed)
# Production (RDS): postgresql+psycopg://veridex:password@rds-host:5432/veridex
DATABASE_URL=sqlite:///data/veridex_meta.db

# Database connection pool settings (production PostgreSQL / RDS)
# DB_POOL_SIZE=10
# DB_MAX_OVERFLOW=20
# DB_POOL_RECYCLE=1800
# DB_POOL_TIMEOUT=30

# Analytical database backend (for in-session query execution)
# "sqlite" (default, zero extra dependencies) | "duckdb" (requires pip install duckdb)
DATABASE_BACKEND=sqlite
DATABASE_PATH=data/veridex.db

# Optional: Connect Streamlit frontend to FastAPI backend via HTTP
API_BASE_URL=http://localhost:8000

# ===========================================================================
# SQL Safety Limits
# ===========================================================================

MAX_RESULT_ROWS=1000
QUERY_TIMEOUT_SECONDS=10
MAX_SQL_REPAIR_ATTEMPTS=2

# ===========================================================================
# Upload and Session Limits
# ===========================================================================

MAX_UPLOAD_MB=50
SESSION_TTL_MINUTES=120

# ===========================================================================
# Observability
# ===========================================================================

# Logging verbosity (DEBUG | INFO | WARNING | ERROR)
LOG_LEVEL=INFO

# CloudWatch Logs (production only; ignored when LOCAL_MODE=true)
# CLOUDWATCH_ENABLED=false
# CLOUDWATCH_LOG_GROUP=/veridex/api

# ===========================================================================
# Reports
# ===========================================================================

# Where generated PDF/Markdown reports are written (local mode)
REPORTS_DIR=outputs/reports
