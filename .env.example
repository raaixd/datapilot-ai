# Copy this file to .env and fill in values as needed.
# Every variable has a safe default (see app/core/config.py), so the app
# runs out of the box with LLM_PROVIDER=mock and no keys at all.

# "mock" (default, no key needed, deterministic) | "anthropic" | "ollama"
LLM_PROVIDER=mock

# Only required if LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=

# Only used if LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434

# Model name passed to whichever provider is selected
LLM_MODEL=claude-sonnet-4-6

# "sqlite" (default, zero extra dependencies) | "duckdb" (requires `pip install duckdb`)
DATABASE_BACKEND=sqlite
DATABASE_PATH=data/datapilot.db

# SQL safety limits
MAX_RESULT_ROWS=1000
QUERY_TIMEOUT_SECONDS=10

# Upload and session limits (enforced by the FastAPI backend)
MAX_UPLOAD_MB=50
SESSION_TTL_MINUTES=120

# Logging verbosity (DEBUG | INFO | WARNING | ERROR)
LOG_LEVEL=INFO

# Where generated PDF/Markdown reports are written
REPORTS_DIR=outputs/reports
